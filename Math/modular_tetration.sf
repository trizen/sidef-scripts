#!/usr/bin/ruby

# Modular computation of the tetration operation, using Euler's theorem.

# See also:
#   https://en.wikipedia.org/wiki/Tetration
#   https://www.youtube.com/watch?v=vzhzwLp_qrs

func tetration(a, b, m) {

    return 0 if (m == 1)
    return 1 if (b == 0)
    return a % m if (b == 1)

    var phi = m.euler_phi
    var exp = __FUNC__(a, b-1, phi)

    # For tetration towers with height b >= 3 (and large enough base),
    # the unreduced exponent is guaranteed to exceed phi, requiring + phi offset.
    if (b >= 3 || exp >= phi) {
        exp = (exp % phi) + phi
    }

    powmod(a, exp, m)
}

for n in (2 .. 1000) {
    var k = n.prime
    if ((tetration(10, 10, k) + 23) % k == 0) {
        say "#{'%3s' % k} | (10∆10 + 23)"
    }
}

__END__
  3 | (10∆10 + 23)
